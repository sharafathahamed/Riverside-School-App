 "css": "<style>\n  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');\n\n  * {\n    margin: 0;\n    padding: 0;\n    box-sizing: border-box;\n  }\n\n  body {\n    font-family: 'Inter', sans-serif;\n    color: #1a1a2e;\n    background: #fff;\n  }\n\n  /* \u2500\u2500 HEADER \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 */\n  .header {\n    background: linear-gradient(135deg, #1e3a5f 0%, #2563eb 100%);\n    color: white;\n    padding: 28px 36px;\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    border-radius: 0 0 12px 12px;\n  }\n\n  .school-name {\n    font-size: 22px;\n    font-weight: 700;\n    letter-spacing: 0.5px;\n  }\n\n  .school-tagline {\n    font-size: 11px;\n    opacity: 0.75;\n    margin-top: 4px;\n    font-weight: 300;\n  }\n\n  .report-badge {\n    background: rgba(255,255,255,0.15);\n    border: 1px solid rgba(255,255,255,0.3);\n    padding: 8px 18px;\n    border-radius: 20px;\n    font-size: 12px;\n    font-weight: 600;\n    letter-spacing: 1px;\n    text-transform: uppercase;\n  }\n\n  /* \u2500\u2500 STUDENT CARD \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 */\n  .student-card {\n    margin: 24px 36px 0;\n    background: #f8fafc;\n    border: 1px solid #e2e8f0;\n    border-radius: 12px;\n    padding: 20px 24px;\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n  }\n\n  .student-avatar {\n    width: 52px;\n    height: 52px;\n    background: linear-gradient(135deg, #2563eb, #1e3a5f);\n    border-radius: 50%;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    color: white;\n    font-size: 20px;\n    font-weight: 700;\n    flex-shrink: 0;\n  }\n\n  .student-info {\n    flex: 1;\n    margin-left: 16px;\n  }\n\n  .student-name {\n    font-size: 18px;\n    font-weight: 700;\n    color: #1e3a5f;\n  }\n\n  .student-meta {\n    display: flex;\n    gap: 20px;\n    margin-top: 6px;\n  }\n\n  .meta-item {\n    font-size: 11px;\n    color: #64748b;\n  }\n\n  .meta-item span {\n    font-weight: 600;\n    color: #334155;\n  }\n\n  .section-badge {\n    background: #1e3a5f;\n    color: white;\n    padding: 6px 14px;\n    border-radius: 20px;\n    font-size: 12px;\n    font-weight: 600;\n  }\n\n  /* \u2500\u2500 STATS ROW \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 */\n  .stats-row {\n    display: flex;\n    gap: 16px;\n    margin: 20px 36px 0;\n  }\n\n  .stat-card {\n    flex: 1;\n    border-radius: 10px;\n    padding: 16px 20px;\n    text-align: center;\n    border: 1px solid;\n  }\n\n  .stat-card.total {\n    background: #eff6ff;\n    border-color: #bfdbfe;\n  }\n\n  .stat-card.present {\n    background: #f0fdf4;\n    border-color: #bbf7d0;\n  }\n\n  .stat-card.absent {\n    background: #fff1f2;\n    border-color: #fecdd3;\n  }\n\n  .stat-card.late {\n    background: #fffbeb;\n    border-color: #fde68a;\n  }\n\n  .stat-number {\n    font-size: 28px;\n    font-weight: 700;\n    line-height: 1;\n  }\n\n  .stat-card.total .stat-number { color: #2563eb; }\n  .stat-card.present .stat-number { color: #16a34a; }\n  .stat-card.absent .stat-number { color: #dc2626; }\n  .stat-card.late .stat-number { color: #d97706; }\n\n  .stat-label {\n    font-size: 10px;\n    font-weight: 600;\n    text-transform: uppercase;\n    letter-spacing: 0.8px;\n    margin-top: 4px;\n    color: #64748b;\n  }\n\n  .stat-percent {\n    font-size: 11px;\n    font-weight: 500;\n    margin-top: 3px;\n    color: #94a3b8;\n  }\n\n  /* \u2500\u2500 PROGRESS BAR \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 */\n  .progress-section {\n    margin: 20px 36px 0;\n    background: #f8fafc;\n    border: 1px solid #e2e8f0;\n    border-radius: 12px;\n    padding: 18px 24px;\n  }\n\n  .progress-title {\n    font-size: 12px;\n    font-weight: 600;\n    color: #475569;\n    text-transform: uppercase;\n    letter-spacing: 0.8px;\n    margin-bottom: 10px;\n  }\n\n  .progress-bar-wrap {\n    background: #e2e8f0;\n    border-radius: 999px;\n    height: 14px;\n    overflow: hidden;\n    display: flex;\n  }\n\n  .bar-present {\n    background: #22c55e;\n    height: 100%;\n    transition: width 0.3s;\n  }\n\n  .bar-late {\n    background: #f59e0b;\n    height: 100%;\n  }\n\n  .bar-absent {\n    background: #ef4444;\n    height: 100%;\n  }\n\n  .progress-legend {\n    display: flex;\n    gap: 20px;\n    margin-top: 10px;\n  }\n\n  .legend-item {\n    display: flex;\n    align-items: center;\n    gap: 6px;\n    font-size: 11px;\n    color: #64748b;\n  }\n\n  .legend-dot {\n    width: 10px;\n    height: 10px;\n    border-radius: 50%;\n    flex-shrink: 0;\n  }\n\n  .eligibility-banner {\n    margin-top: 12px;\n    padding: 8px 14px;\n    border-radius: 8px;\n    font-size: 12px;\n    font-weight: 600;\n    text-align: center;\n  }\n\n  .eligible {\n    background: #dcfce7;\n    color: #15803d;\n    border: 1px solid #86efac;\n  }\n\n  .not-eligible {\n    background: #fee2e2;\n    color: #b91c1c;\n    border: 1px solid #fca5a5;\n  }\n\n  /* \u2500\u2500 ATTENDANCE TABLE \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 */\n  .table-section {\n    margin: 20px 36px 0;\n  }\n\n  .table-title {\n    font-size: 13px;\n    font-weight: 700;\n    color: #1e3a5f;\n    margin-bottom: 10px;\n    padding-bottom: 8px;\n    border-bottom: 2px solid #e2e8f0;\n    text-transform: uppercase;\n    letter-spacing: 0.5px;\n  }\n\n  .att-table {\n    width: 100%;\n    border-collapse: collapse;\n    font-size: 12px;\n  }\n\n  .att-table thead tr {\n    background: #1e3a5f;\n    color: white;\n  }\n\n  .att-table thead th {\n    padding: 10px 14px;\n    text-align: left;\n    font-weight: 600;\n    font-size: 11px;\n    letter-spacing: 0.5px;\n    text-transform: uppercase;\n  }\n\n  .att-table thead th:first-child {\n    border-radius: 6px 0 0 0;\n  }\n\n  .att-table thead th:last-child {\n    border-radius: 0 6px 0 0;\n    text-align: center;\n  }\n\n  .att-table tbody tr {\n    border-bottom: 1px solid #f1f5f9;\n  }\n\n  .att-table tbody tr:nth-child(even) {\n    background: #f8fafc;\n  }\n\n  .att-table tbody tr:hover {\n    background: #eff6ff;\n  }\n\n  .att-table td {\n    padding: 9px 14px;\n    color: #334155;\n  }\n\n  .att-table td:last-child {\n    text-align: center;\n  }\n\n  .status-pill {\n    display: inline-block;\n    padding: 3px 12px;\n    border-radius: 999px;\n    font-size: 10px;\n    font-weight: 700;\n    text-transform: uppercase;\n    letter-spacing: 0.5px;\n  }\n\n  .pill-present {\n    background: #dcfce7;\n    color: #15803d;\n  }\n\n  .pill-absent {\n    background: #fee2e2;\n    color: #b91c1c;\n  }\n\n  .pill-late {\n    background: #fef3c7;\n    color: #b45309;\n  }\n\n  .pill-excused {\n    background: #e0e7ff;\n    color: #4338ca;\n  }\n\n  /* \u2500\u2500 FOOTER \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 */\n  .footer {\n    margin: 28px 36px 20px;\n    padding-top: 16px;\n    border-top: 1px solid #e2e8f0;\n    display: flex;\n    justify-content: space-between;\n    align-items: flex-end;\n  }\n\n  .footer-left {\n    font-size: 10px;\n    color: #94a3b8;\n    line-height: 1.6;\n  }\n\n  .signature-block {\n    text-align: center;\n  }\n\n  .signature-line {\n    width: 160px;\n    border-top: 1.5px solid #334155;\n    margin-bottom: 4px;\n  }\n\n  .signature-label {\n    font-size: 10px;\n    color: #475569;\n    font-weight: 600;\n  }\n\n  .no-data {\n    text-align: center;\n    padding: 30px;\n    color: #94a3b8;\n    font-size: 13px;\n  }\n</style>\n\n{% set student_doc = frappe.get_doc(\"Student\", doc.student) %}\n{% set class_section = doc.class_section %}\n\n{# \u2500\u2500 Find current Academic Term \u2500\u2500 #}\n{% set term = frappe.db.get_value(\"Academic Term\",\n    {\"start_date\": [\"<=\", doc.date], \"end_date\": [\">=\", doc.date]},\n    [\"name\", \"start_date\", \"end_date\"], as_dict=True) %}\n\n{# \u2500\u2500 If no term found use a wide range fallback \u2500\u2500 #}\n{% if not term %}\n  {% set term = frappe.db.get_value(\"Academic Term\",\n      {},\n      [\"name\", \"start_date\", \"end_date\"],\n      order_by=\"end_date desc\",\n      as_dict=True) %}\n{% endif %}\n\n{# \u2500\u2500 Fetch all attendance for this student in this term \u2500\u2500 #}\n{% set records = frappe.get_all(\"Attendance\",\n    filters={\n        \"student\": doc.student,\n        \"class_section\": class_section,\n        \"docstatus\": 1,\n        \"date\": [\"between\", [term.start_date, term.end_date]]\n    },\n    fields=[\"date\", \"status\"],\n    order_by=\"date asc\") %}\n\n{# \u2500\u2500 Calculate stats \u2500\u2500 #}\n{% set total = records | length %}\n{% set present_count = records | selectattr(\"status\", \"equalto\", \"Present\") | list | length %}\n{% set absent_count  = records | selectattr(\"status\", \"equalto\", \"Absent\")  | list | length %}\n{% set late_count    = records | selectattr(\"status\", \"equalto\", \"Late\")    | list | length %}\n{% set excused_count = records | selectattr(\"status\", \"equalto\", \"Excused\") | list | length %}\n\n{% if total > 0 %}\n  {% set present_pct = ((present_count + late_count) / total * 100) | round(1) %}\n  {% set absent_pct  = (absent_count  / total * 100) | round(1) %}\n  {% set late_pct    = (late_count    / total * 100) | round(1) %}\n{% else %}\n  {% set present_pct = 0 %}\n  {% set absent_pct  = 0 %}\n  {% set late_pct    = 0 %}\n{% endif %}\n\n{% set present_bar = (present_count / total * 100) if total > 0 else 0 %}\n{% set late_bar    = (late_count    / total * 100) if total > 0 else 0 %}\n{% set absent_bar  = (absent_count  / total * 100) if total > 0 else 0 %}\n\n{# \u2500\u2500 Initial of student name for avatar \u2500\u2500 #}\n{% set initial = student_doc.full_name[0].upper() %}\n\n<!-- \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550 HEADER \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550 -->\n<div class=\"header\">\n  <div>\n    <div class=\"school-name\">\ud83c\udfeb Riverside Academy</div>\n    <div class=\"school-tagline\">Senior Secondary School \u2014 Excellence in Education</div>\n  </div>\n  <div class=\"report-badge\">Attendance Report</div>\n</div>\n\n<!-- \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550 STUDENT CARD \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550 -->\n<div class=\"student-card\">\n  <div class=\"student-avatar\">{{ initial }}</div>\n  <div class=\"student-info\">\n    <div class=\"student-name\">{{ student_doc.full_name }}</div>\n    <div class=\"student-meta\">\n      <div class=\"meta-item\">Guardian: <span>{{ student_doc.guardian_name or \"\u2014\" }}</span></div>\n      <div class=\"meta-item\">DOB: <span>{{ student_doc.date_of_birth or \"\u2014\" }}</span></div>\n      <div class=\"meta-item\">Gender: <span>{{ student_doc.gender or \"\u2014\" }}</span></div>\n      <div class=\"meta-item\">Term: <span>{{ term.name }}</span></div>\n    </div>\n  </div>\n  <div class=\"section-badge\">{{ class_section }}</div>\n</div>\n\n<!-- \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550 STATS ROW \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550 -->\n<div class=\"stats-row\">\n  <div class=\"stat-card total\">\n    <div class=\"stat-number\">{{ total }}</div>\n    <div class=\"stat-label\">Total Days</div>\n    <div class=\"stat-percent\">Recorded</div>\n  </div>\n  <div class=\"stat-card present\">\n    <div class=\"stat-number\">{{ present_count }}</div>\n    <div class=\"stat-label\">Present</div>\n    <div class=\"stat-percent\">\n      {% if total > 0 %}{{ (present_count / total * 100) | round(1) }}%{% else %}0%{% endif %}\n    </div>\n  </div>\n  <div class=\"stat-card absent\">\n    <div class=\"stat-number\">{{ absent_count }}</div>\n    <div class=\"stat-label\">Absent</div>\n    <div class=\"stat-percent\">{{ absent_pct }}%</div>\n  </div>\n  <div class=\"stat-card late\">\n    <div class=\"stat-number\">{{ late_count }}</div>\n    <div class=\"stat-label\">Late</div>\n    <div class=\"stat-percent\">{{ late_pct }}%</div>\n  </div>\n</div>\n\n<!-- \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550 PROGRESS BAR \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550 -->\n<div class=\"progress-section\">\n  <div class=\"progress-title\">Attendance Breakdown</div>\n  <div class=\"progress-bar-wrap\">\n    <div class=\"bar-present\" style=\"width: {{ present_bar }}%\"></div>\n    <div class=\"bar-late\"    style=\"width: {{ late_bar }}%\"></div>\n    <div class=\"bar-absent\"  style=\"width: {{ absent_bar }}%\"></div>\n  </div>\n  <div class=\"progress-legend\">\n    <div class=\"legend-item\">\n      <div class=\"legend-dot\" style=\"background:#22c55e\"></div>\n      Present ({{ present_count }} days)\n    </div>\n    <div class=\"legend-item\">\n      <div class=\"legend-dot\" style=\"background:#f59e0b\"></div>\n      Late ({{ late_count }} days)\n    </div>\n    <div class=\"legend-item\">\n      <div class=\"legend-dot\" style=\"background:#ef4444\"></div>\n      Absent ({{ absent_count }} days)\n    </div>\n  </div>\n\n  <!-- Eligibility Banner -->\n  {% if present_pct >= 60 %}\n    <div class=\"eligibility-banner eligible\">\n      \u2705 Eligible for Examinations \u2014 Attendance {{ present_pct }}% (Minimum 60% required)\n    </div>\n  {% else %}\n    <div class=\"eligibility-banner not-eligible\">\n      \u26a0\ufe0f Not Eligible for Examinations \u2014 Attendance {{ present_pct }}% (Below 60% minimum)\n    </div>\n  {% endif %}\n</div>\n\n<!-- \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550 ATTENDANCE TABLE \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550 -->\n<div class=\"table-section\">\n  <div class=\"table-title\">Day-wise Attendance Record \u2014 {{ term.name }}</div>\n\n  {% if records %}\n    <table class=\"att-table\">\n      <thead>\n        <tr>\n          <th>#</th>\n          <th>Date</th>\n          <th>Day</th>\n          <th>Status</th>\n        </tr>\n      </thead>\n      <tbody>\n        {% for r in records %}\n          {% set day_names = [\"Mon\",\"Tue\",\"Wed\",\"Thu\",\"Fri\",\"Sat\",\"Sun\"] %}\n          <tr>\n            <td style=\"color:#94a3b8; font-size:11px;\">{{ loop.index }}</td>\n            <td><strong>{{ r.date }}</strong></td>\n            <td style=\"color:#64748b;\">\n              {{ r.date.strftime(\"%A\") if r.date else \"\u2014\" }}\n            </td>\n            <td>\n              {% if r.status == \"Present\" %}\n                <span class=\"status-pill pill-present\">\u2713 Present</span>\n              {% elif r.status == \"Absent\" %}\n                <span class=\"status-pill pill-absent\">\u2717 Absent</span>\n              {% elif r.status == \"Late\" %}\n                <span class=\"status-pill pill-late\">\u23f1 Late</span>\n              {% elif r.status == \"Excused\" %}\n                <span class=\"status-pill pill-excused\">~ Excused</span>\n              {% else %}\n                <span class=\"status-pill\">{{ r.status }}</span>\n              {% endif %}\n            </td>\n          </tr>\n        {% endfor %}\n      </tbody>\n    </table>\n  {% else %}\n    <div class=\"no-data\">No attendance records found for this term.</div>\n  {% endif %}\n</div>\n\n<!-- \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550 FOOTER \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550 -->\n<div class=\"footer\">\n  <div class=\"footer-left\">\n    Generated on: {{ frappe.utils.now_datetime().strftime(\"%d %B %Y, %I:%M %p\") }}<br>\n    Term Period: {{ term.start_date }} to {{ term.end_date }}<br>\n    This is a system-generated report from Riverside Academy SMS.\n  </div>\n  <div class=\"signature-block\">\n    <div class=\"signature-line\"></div>\n    <div class=\"signature-label\">Head Teacher Signature</div>\n  </div>\n</div>",
